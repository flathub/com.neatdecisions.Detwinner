{
    "app-id": "com.neatdecisions.Detwinner",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "detwinner",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=host",
        "--filesystem=xdg-run/gvfsd",
        "--talk-name=org.gtk.vfs.*"
    ],
    "cleanup": [
        "/bin/gm",
        "/bin/GraphicsMagick*",
        "/include",
        "/lib/cmake",
        "/lib/GraphicsMagick*",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/GraphicsMagick-*",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        "gtkmm.json",
        {
            "name": "graphicsmagick",
            "builddir": true,
            "config-opts": [
                "--enable-shared",
                "--disable-compressed-files",
                "--disable-static",
                "--with-quantum-depth=16",
                "--with-threads",
                "--without-dps",
                "--without-gs",
                "--without-lcms2",
                "--without-perl",
                "--without-trio",
                "--without-ttf",
                "--without-wmf",
                "--without-x"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://sourceforge.net/projects/graphicsmagick/files/graphicsmagick/1.3.45/GraphicsMagick-1.3.45.tar.xz",
                    "sha256": "dcea5167414f7c805557de2d7a47a9b3147bcbf617b91f5f0f4afe5e6543026b"
                }
            ]
        },
        {
            "name": "gtest",
            "buildsystem": "cmake",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz",
                    "sha256": "8ad598c73ad796e0d8280b082cebd82a630d73e73cd3c70057938a6501bba5d7"
                }
            ]
        },
        {
            "name": "detwinner",
            "buildsystem": "meson",
            "builddir": true,
            "build-options": {
                "cxxflags": "-Wno-error=sfinae-incomplete"
            },
            "sources": [
                {
                    "type": "archive",
                    "archive-type": "tar-gzip",
                    "url": "https://api.github.com/repos/neatdecisions/detwinner/tarball/v0.4.2",
                    "sha256": "ee671f24d44fe5f9196d37f418abcc4a9d572f09338010d35195544f72d821c3",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "json",
                        "url": "https://api.github.com/repos/neatdecisions/detwinner/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": ".tarball_url"
                    }
                },
                {
                    "type": "patch",
                    "path": "fix-appdata.patch"
                }
            ]
        }
    ]
}
